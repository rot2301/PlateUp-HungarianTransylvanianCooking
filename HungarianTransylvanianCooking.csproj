<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<AssemblyName>$(MSBuildProjectName)-Workshop</AssemblyName>
		<RootNamespace>HungarianTransylvanianCooking</RootNamespace>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<!-- 0618: KitchenLib marks some helpers we rely on as [Obsolete] -->
		<NoWarn>CS0114;CS0618</NoWarn>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<!--
		References come from the git-ignored lib/ folder: copy PlateUp/PlateUp_Data/Managed/*.dll
		plus KitchenLib.dll (and any other mod DLLs) from the workshop folder into it.
		The built DLL goes to bin/<Configuration>/net472/.
	-->
	<ItemGroup>
		<!-- These clash with the .NET Framework reference assemblies -->
		<LibBlacklist Include="lib/**/System.Buffers.dll;lib/**/Microsoft.Extensions.Logging.Abstractions.dll;lib/**/Mono.Posix.dll;lib/**/Mono.Security.dll;lib/**/System.Memory.dll;lib/**/System.Runtime.CompilerServices.Unsafe.dll" />
		<Reference Include="lib/**/*.dll" Exclude="@(LibBlacklist)" Private="false" />
	</ItemGroup>

</Project>
