<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<AssemblyName>$(MSBuildProjectName)-Workshop</AssemblyName>
		<RootNamespace>HungarianTransylvanianCooking</RootNamespace>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<!-- 0618: KitchenLib marks some helpers we rely on as [Obsolete] -->
		<NoWarn>CS0114;CS0618</NoWarn>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<!-- Keep the built DLL in bin/ instead of copying it into the game's Mods folder -->
		<EnableModDeployLocal>false</EnableModDeployLocal>
	</PropertyGroup>

	<!--
		The build package finds PlateUp through Steam automatically to reference the game's DLLs.
		The built DLL stays in bin/<Configuration>/net472/. If it can't find the game, pass the
		folder that contains PlateUp.exe, e.g.

			dotnet build -c Release -p:GamePath="D:\SteamLibrary\steamapps\common\PlateUp\PlateUp"

		or put <GamePath> in a git-ignored Directory.Build.props next to this file.
	-->
	<ItemGroup>
		<PackageReference Include="Yariazen.PlateUp.ModBuildUtilities" Version="1.13.0" />
	</ItemGroup>

</Project>
